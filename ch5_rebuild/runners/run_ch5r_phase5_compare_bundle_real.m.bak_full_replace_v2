function out = run_ch5r_phase5_compare_bundle_real()
%RUN_CH5R_PHASE5_COMPARE_BUNDLE_REAL
% Build bridge comparison bundle for:
%   R3-real : static-hold baseline
%   R4-real : tracking-greedy baseline
%   R5-real : bubble-predictive baseline

cfg = default_ch5r_params();

out3 = run_ch5r_phase3_static_bubble_demo();
out4 = run_ch5r_phase4_tracking_baseline();
out5 = run_ch5r_phase5_bubble_predictive();

stamp = datestr(now, 'yyyymmdd_HHMMSS');
out_dir = fullfile(cfg.ch5r.output_root, 'phaseR5_compare_bundle_real');
if ~exist(out_dir, 'dir')
    mkdir(out_dir);
end

compare_table = local_build_compare_table(out3, out4, out5);

csv_file = fullfile(out_dir, ['phaseR5_compare_table_real_' stamp '.csv']);
writetable(compare_table, csv_file);

rmse_fig = plot_ch5r_rmse_proxy_comparison(out4, out5, out_dir, stamp);
rmse_fig_file = '';
if isstruct(rmse_fig)
    if isfield(rmse_fig, 'save_path') && ~isempty(rmse_fig.save_path)
        rmse_fig_file = rmse_fig.save_path;
    end
elseif ischar(rmse_fig) || isstring(rmse_fig)
    rmse_fig_file = char(rmse_fig);
end

md = local_build_md(compare_table, out3, out4, out5, csv_file, rmse_fig_file);
md_file = fullfile(out_dir, ['phaseR5_compare_bundle_real_' stamp '.md']);
fid = fopen(md_file, 'w');
fprintf(fid, '%s', md);
fclose(fid);

mat_file = fullfile(out_dir, ['phaseR5_compare_bundle_real_' stamp '.mat']);
save(mat_file, 'cfg', 'out3', 'out4', 'out5', 'compare_table', 'rmse_fig_file');

disp(' ')
disp('=== [ch5r:R5c-real] R3-real vs R4-real vs R5-real comparison summary ===')
disp(compare_table)
disp(['compare csv         : ' csv_file])
disp(['compare md          : ' md_file])
disp(['compare mat         : ' mat_file])
disp(['rmse fig            : ' rmse_fig_file])
disp(' ')

out = struct();
out.ok = true;
out.cfg = cfg;
out.out3 = out3;
out.out4 = out4;
out.out5 = out5;
out.summary = compare_table;
out.paths = struct( ...
    'csv_file', csv_file, ...
    'md_file', md_file, ...
    'mat_file', mat_file, ...
    'rmse_fig', rmse_fig_file, ...
    'output_dir', out_dir);
end

function T = local_build_compare_table(out3, out4, out5)

policy = [
    "R3-real_static_pair"
    "R4-real_dynamic_pair"
    "R5-real_predictive_pair"
    ];

bubble_steps = [
    out3.result.bubble_metrics.bubble_steps
    out4.result.bubble_metrics.bubble_steps
    out5.result.bubble_metrics.bubble_steps
    ];

bubble_fraction = [
    out3.result.bubble_metrics.bubble_fraction
    out4.result.bubble_metrics.bubble_fraction
    out5.result.bubble_metrics.bubble_fraction
    ];

bubble_time_s = [
    out3.result.bubble_metrics.bubble_time_s
    out4.result.bubble_metrics.bubble_time_s
    out5.result.bubble_metrics.bubble_time_s
    ];

longest_bubble_time_s = [
    out3.result.bubble_metrics.longest_bubble_time_s
    out4.result.bubble_metrics.longest_bubble_time_s
    out5.result.bubble_metrics.longest_bubble_time_s
    ];

max_bubble_depth = [
    out3.result.bubble_metrics.max_bubble_depth
    out4.result.bubble_metrics.max_bubble_depth
    out5.result.bubble_metrics.max_bubble_depth
    ];

mean_bubble_depth = [
    out3.result.bubble_metrics.mean_bubble_depth
    out4.result.bubble_metrics.mean_bubble_depth
    out5.result.bubble_metrics.mean_bubble_depth
    ];

loc_total_time_s = [
    out3.result.bubble_metrics.loc_total_time_s
    out4.result.bubble_metrics.loc_total_time_s
    out5.result.bubble_metrics.loc_total_time_s
    ];

custody_ratio = [
    out3.result.custody_metrics.custody_ratio
    out4.result.custody_metrics.custody_ratio
    out5.result.custody_metrics.custody_ratio
    ];

mean_rmse_proxy = [
    out3.result.rmse_metrics.mean_rmse_proxy
    out4.result.rmse_metrics.mean_rmse_proxy
    out5.result.rmse_metrics.mean_rmse_proxy
    ];

min_margin = [
    out3.result.margin_metrics.min_margin
    out4.result.margin_metrics.min_margin
    out5.result.margin_metrics.min_margin
    ];

switch_count = [
    out3.result.cost_metrics.switch_count
    out4.result.cost_metrics.switch_count
    out5.result.cost_metrics.switch_count
    ];

resource_score = [
    out3.result.cost_metrics.resource_score
    out4.result.cost_metrics.resource_score
    out5.result.cost_metrics.resource_score
    ];

observable_steps = [
    out3.result.observable_metrics.observable_steps
    out4.result.observable_metrics.observable_steps
    out5.result.observable_metrics.observable_steps
    ];

T = table( ...
    policy, ...
    bubble_steps, ...
    bubble_fraction, ...
    bubble_time_s, ...
    longest_bubble_time_s, ...
    max_bubble_depth, ...
    mean_bubble_depth, ...
    loc_total_time_s, ...
    custody_ratio, ...
    mean_rmse_proxy, ...
    min_margin, ...
    switch_count, ...
    resource_score, ...
    observable_steps);
end

function md = local_build_md(T, out3, out4, out5, csv_file, rmse_fig_file)

lines = {};
lines{end+1} = '# Phase R5 compare bundle (real)';
lines{end+1} = '';
lines{end+1} = 'This bundle compares the real-scene bridge chain:';
lines{end+1} = '';
lines{end+1} = '- R3-real: static-hold baseline';
lines{end+1} = '- R4-real: tracking-greedy baseline';
lines{end+1} = '- R5-real: bubble-predictive baseline';
lines{end+1} = '';
lines{end+1} = '## Summary';
lines{end+1} = '';

lines{end+1} = '| policy | bubble_steps | bubble_fraction | bubble_time_s | longest_bubble_time_s | max_bubble_depth | mean_bubble_depth | loc_total_time_s | custody_ratio | mean_rmse_proxy | min_margin | switch_count | resource_score | observable_steps |';
lines{end+1} = '|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|';

for i = 1:height(T)
    lines{end+1} = sprintf('| %s | %d | %.6f | %.6f | %.6f | %.10g | %.10g | %.6f | %.6f | %.10g | %.10g | %d | %d | %d |', ...
        T.policy(i), ...
        T.bubble_steps(i), ...
        T.bubble_fraction(i), ...
        T.bubble_time_s(i), ...
        T.longest_bubble_time_s(i), ...
        T.max_bubble_depth(i), ...
        T.mean_bubble_depth(i), ...
        T.loc_total_time_s(i), ...
        T.custody_ratio(i), ...
        T.mean_rmse_proxy(i), ...
        T.min_margin(i), ...
        T.switch_count(i), ...
        T.resource_score(i), ...
        T.observable_steps(i));
end

lines{end+1} = '';
lines{end+1} = '## Key observations';
lines{end+1} = '';
lines{end+1} = sprintf('- R3-real bubble steps: %d', out3.result.bubble_metrics.bubble_steps);
lines{end+1} = sprintf('- R4-real bubble steps: %d', out4.result.bubble_metrics.bubble_steps);
lines{end+1} = sprintf('- R5-real bubble steps: %d', out5.result.bubble_metrics.bubble_steps);
lines{end+1} = '';
lines{end+1} = 'Bridge trend: static hold is worst, greedy dynamic improves, predictive bubble suppression improves further.';
lines{end+1} = '';
lines{end+1} = ['- Compare csv: `', csv_file, '`'];
if ~isempty(rmse_fig_file)
    lines{end+1} = ['- RMSE proxy figure (R4 vs R5): `', rmse_fig_file, '`'];
end

md = strjoin(lines, newline);
end
